<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/lista_voltar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/lista_voltar"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/et_busca_vinho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/buscar_vinho"
            android:background="@drawable/edit_text_bg"
            android:padding="8dp"/>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo2"/>
    </LinearLayout>

    <android.widget.Button
        android:id="@+id/btn_adicionar_vinho"
        style="@style/ActionButton"
        android:layout_width="150dp"
        android:layout_height="45dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="8dp"
        android:text="@string/adicionar_vinho" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_vinhos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/> <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible"/> </FrameLayout>

</LinearLayout>